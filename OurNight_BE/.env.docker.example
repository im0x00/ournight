# =============================================================================
# 로컬: 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요. (저장소에 .env 커밋 금지)
#
# · docker compose 의 Postgres 는 DB_USERNAME / DB_PASSWORD / POSTGRES_DB 를 사용합니다.
# · Spring 은 DB_URL / DB_USERNAME / DB_PASSWORD 를 그대로 씁니다. (DB_URL 마지막 경로와 POSTGRES_DB 를 맞추세요)
# · 제가 터미널에서 쓰던 임의 비밀번호가 아니라, 반드시 본인이 정한 값만 쓰세요.
# =============================================================================
# API 서버만 Docker 이미지로 실행할 때 — 호스트(또는 같은 서버)의 DB·Redis 와 통신
# =============================================================================
# docker compose 는 postgres/redis 만 띄우고, api-server 는 따로 실행한다고 가정합니다.
#
# 컨테이너 안에서 localhost 는 "그 컨테이너 자신"이므로,
# 호스트에서 돌아가는 Postgres/Redis 에는 아래처럼 호스트 주소를 써야 합니다.
#
# 권장 (Docker Desktop Mac/Windows, 또는 Linux 에서 host-gateway 지정 시):
#   DB_URL / REDIS_HOST 에 host.docker.internal 사용
#
# Linux (docker run) 예:
#   docker run --add-host=host.docker.internal:host-gateway \
#     --env-file .env.docker -p 8080:8080 <이미지>
#
# host.docker.internal 이 안 되면 호스트의 실제 IP 또는 docker0 게이트웨이(보통 172.17.0.1)로 바꿉니다.
# DB/Redis 가 DB 서버에만 떠 있으면 그 서버의 호스트명/IP 로 지정합니다.
# =============================================================================

# --- DB (로컬 docker compose 와 동일 계정·DB 이름 맞춤)
POSTGRES_DB=postgres
DB_URL=jdbc:postgresql://localhost:5432/postgres
# DB_URL=jdbc:postgresql://localhost:5432/ournight_local
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JPA (선택) application.yaml 기본은 update. Hibernate가 스키마를 바꾸지 않게 하려면 DDL_AUTO=validate
# DDL_AUTO=validate

# --- Redis (호스트)
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# --- JWT
JWT_SECRET=change-me-to-a-long-random-secret

# --- Kakao (redirect 는 카카오 콘솔·프론트와 동일하게)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Client
APP_CLIENT_BASE_URL=http://localhost:3000

# --- CORS (콤마로 구분된 허용 origin 목록)
# local  : http://localhost:3000
# alpha  : http://localhost:3000,https://alpha.ournight.co.kr
# prod   : https://ournight.co.kr
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AWS S3 (프로파일별 기본은 application*.yaml 참고)
#   local  : ournight-s3-local-runtime + ournight-s3-local-runtime.s3.ap-northeast-2.amazonaws.com (직접 S3, CF 없음)
#   alpha  : ournight-s3-alpha-runtime + alpha.image.ournight.co.kr (profile=alpha)
#   prod   : ournight-s3-alpha     + image.ournight.co.kr   (프로파일 없음 또는 명시적 env)
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_DOMAIN=
